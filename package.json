{
  "name": "@platform/runtime-mf-adapters",
  "version": "0.1.3",
  "description": "Framework mount adapters for the Runtime MF Contract",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "import": "./dist/angular/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "npm run build && husky",
    "format:fix": "prettier --write .",
    "release": "bumpp"
  },
  "peerDependencies": {
    "@angular/core": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@platform/runtime-mf-contract": "^0.4.0 || ^0.5.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@angular/platform-browser": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@angular/common": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@platform/runtime-mf-contract": "github:tryproxy/runtime-mf-contract#v0.5.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "bumpp": "^12.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rxjs": "~7.8.0",
    "typescript": "~5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tryproxy/runtime-mf-adapters.git"
  },
  "license": "MIT",
  "lint-staged": {
    "**/*.{js,ts,json,md,yml,yaml}": "prettier --write"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
